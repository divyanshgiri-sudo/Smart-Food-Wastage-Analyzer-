# Student Backend Environment Variables
PORT=5000

# SQLite Persistent Volume Path (map to Railway volume, e.g. /data/smartmess.db)
DB_PATH=./data/smartmess.db

# Vercel Frontend URL (comma-separated if multiple, e.g. https://student.vercel.app)
FRONTEND_URL=http://localhost:5173

# Google OAuth2 Credentials for Gmail HTTP API (port 443)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ACCESS_TOKEN=
GMAIL_USER=vitap.smartmess@gmail.com
EMAIL_FROM="VIT-AP Smart Mess" <vitap.smartmess@gmail.com>

JWT_SECRET=your-jwt-secret-key-here
